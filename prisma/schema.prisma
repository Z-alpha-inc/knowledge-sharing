// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// https://www.prisma.io/docs/orm/prisma-client/setup-and-configuration/generating-prisma-client
// カスタムアウトプットは公式の強い推奨

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// prisma/schema.prisma (最初はこれだけでOK)
model User {
  id        String    @id @default(cuid()) @map("_id")
  name      String
  email     String    // unique制約は不要, 10/16追記
  role        Role     @default(VIEWER)
  department  String  // sales, engineering, pr, all
  articles  Article[]
}

enum Role {
  ADMIN
  REVIEWER
  CONTRIBUTOR
  VIEWER
}

// @relation, リレーションフィールド = データベースには存在しない仮想的なフィールド
// authorIdを使ってUserテーブルを検索し、著者情報を結合したものをautherとして出力
// 3つのフィールドだけPOSTすればいい
model Article {
  id        String   @id @default(cuid()) @map("_id") // @defaultで一意のIDが自動生成
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) // @defaultで時間が自動生成
}
